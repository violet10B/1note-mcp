# Copy to .env and adjust. Everything here is optional — the server runs
# without any of it, which is the point: no Azure app registration is needed.

# Raw Microsoft Graph access token. Expires in ~1 hour and does NOT refresh.
# A fallback for CI or one-off scripts — prefer `npm run auth`, whose MSAL
# cache refreshes silently for ~90 days.
# GRAPH_ACCESS_TOKEN=

# House style for written pages: "house" (styled, consistent) or "native"
# (OneNote's own per-level look, indistinguishable from app-authored pages).
# An unknown value is a startup error, never a silent fallback.
# ONENOTE_STYLE=house

# Override the public Graph Explorer client id used for device-code login.
# Only needed if you registered your own app in Entra ID, or if Microsoft
# retires the bundled one.
# ONENOTE_CLIENT_ID=
